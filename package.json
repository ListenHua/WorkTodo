{
  "name": "worktodo",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm version:check && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run && node --test scripts/tests/release.test.mjs",
    "test:watch": "vitest",
    "tauri": "node scripts/desktop.mjs",
    "desktop:dev": "node scripts/desktop.mjs dev",
    "desktop:build": "node scripts/build-package.mjs",
    "build:mac": "node scripts/build-package.mjs --bundles app,dmg",
    "build:windows": "node scripts/build-windows.mjs",
    "rust:check": "node scripts/desktop.mjs cargo check --manifest-path src-tauri/Cargo.toml --locked",
    "rust:test": "node scripts/desktop.mjs cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "check": "pnpm typecheck && pnpm build",
    "rust:fmt": "node scripts/desktop.mjs cargo fmt --manifest-path src-tauri/Cargo.toml",
    "rust:lint": "node scripts/desktop.mjs cargo clippy --manifest-path src-tauri/Cargo.toml --locked --all-targets -- -D warnings",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts .github \"*.ts\" \"*.json\" index.html \"src-tauri/*.json\" \"src-tauri/capabilities/*.json\"",
    "format:check": "prettier --check src scripts .github \"*.ts\" \"*.json\" index.html \"src-tauri/*.json\" \"src-tauri/capabilities/*.json\"",
    "icons:generate": "node scripts/generate-icons.mjs",
    "package:report": "node scripts/package-report.mjs",
    "version:prepare": "node scripts/version.mjs prepare",
    "version:check": "node scripts/version.mjs check",
    "changelog:generate": "node scripts/version.mjs generate",
    "package:build": "node scripts/build-package.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:stage": "node scripts/release-draft.mjs"
  },
  "dependencies": {
    "@mingcute/vue": "3.1.0",
    "@tauri-apps/api": "^2",
    "naive-ui": "^2",
    "pinia": "^3",
    "vue": "^3.5.45",
    "vue-router": "^4"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22",
    "@vitejs/plugin-vue": "^6.0.11",
    "prettier": "3.10.1",
    "typescript": "^5.9",
    "vite": "^8.3.8",
    "vitest": "^4",
    "vue-tsc": "^3"
  }
}
